# DVAI environment — copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit a real key.

# OpenAI API key. Replace the placeholder with your own key to enable the live bot.
# While left as the placeholder (or empty), DVAI returns a canned stub reply so the
# app still runs end to end without a key.
OPENAI_API_KEY=sk-placeholder-replace-me

# Cheapest available chat model. Swappable without touching code.
MODEL_NAME=gpt-4o-mini

# Flask session signing key. Any random string for local lab use.
FLASK_SECRET_KEY=dev-secret-change-me
